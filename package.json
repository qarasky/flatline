{
    "name": "flatline",
    "version": "2.0.0",
    "private": true,
    "description": "Flatline — Rust backend, Go fleet agent, React dashboard.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/artchsh/flatline.git",
        "directory": "."
    },
    "//": "Node is a build/test tool only: the backend is Rust, the agent is Go, and the dashboard is bundled by Vite. Nothing here is a runtime dependency.",
    "scripts": {
        "fmt": "prettier --write \"**/*.{ts,tsx,css,json,md,yml,yaml}\"",
        "test:dashboard": "node --import=tsx --test apps/dashboard/test/*.mjs",
        "build:dashboard": "npm --prefix apps/dashboard run build",
        "typecheck:dashboard": "npm --prefix apps/dashboard run typecheck"
    },
    "devDependencies": {
        "prettier": "^3.8.1",
        "tsx": "^4.23.13"
    }
}
