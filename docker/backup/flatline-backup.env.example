# /etc/flatline-backup.env (mode 0600, root) — read by flatline-backup.service.
# Every line is optional; the defaults match the office host.

#FLATLINE_DB=/home/office/flatline/data-rust/flatline.db
#BACKUP_DIR=/home/office/flatline/backups/nightly
#KEEP_DAILY=14
#KEEP_WEEKLY=8
# ISO weekday kept as the weekly copy (7 = Sunday).
#WEEKLY_DAY=7

# Off-host copy, skipped while empty. The backup directory is mirrored
# (deletions included, so the remote follows the rotation).
#   rsync over ssh (root's key must be authorised on the target):
#OFFSITE_TOOL=rsync
#OFFSITE_TARGET=backup@nas.example:/srv/backups/flatline
#   rclone (remote configured in /root/.config/rclone/rclone.conf):
#OFFSITE_TOOL=rclone
#OFFSITE_TARGET=b2:flatline-backups

# Fetched after a successful run; alert when it stops arriving.
#NOTIFY_URL=https://hc-ping.com/<uuid>
