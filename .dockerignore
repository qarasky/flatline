# Build context for the Flatline image (docker/rust.dockerfile).
#
# The stages copy: packages/shared, apps/dashboard, superboard, backend-rs,
# docs/provisioning.md and agent-install.sh. Everything below is local state,
# dependency trees or build output the image never needs.

# Version control and local state
.git
.gitignore
.DS_Store
.dev-data
.dev-logs
.env
.idea
.vscode
private
tmp
out
data

# Installed dependencies and build output
node_modules
apps/*/node_modules
packages/*/node_modules
apps/*/dist
apps/*/out
apps/*/.next
dist
dist-ssr
backend-rs/target
superboard/flatline-superboard

# Repository metadata the image does not carry
.github
LICENSE
CONTRIBUTING.md

# Retired upstream paths, kept out in case they ever reappear
kubernetes
test
app.json
CNAME
install.sh
yarn.lock
ecosystem.config.js
