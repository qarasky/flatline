# Copy to .env next to compose.yaml. Placeholders only; never commit real values.

# Images (compose.yaml pulls ghcr.io/qarasky/flatline-{backend,web,caddy}:edge by default).
# FLATLINE_IMAGE_PREFIX=ghcr.io/qarasky/flatline
# FLATLINE_VERSION=edge

# Where Caddy listens, and the public origin users reach it at.
# FLATLINE_BIND=0.0.0.0
# FLATLINE_PORT=3001
FLATLINE_PUBLIC_URL=https://uptime.example

# Kore ID single sign-on (docs/sso.md). It is the ONLY browser sign-in.
# Set KORE_ID_ISSUER before the first person signs in; with it empty the
# sign-in page says that no sign-in method is configured.
KORE_ID_ISSUER=
KORE_ID_CLIENT_ID=flatline
KORE_ID_CLIENT_SECRET=
# KORE_ID_CLIENT_AUTH=basic
# Default: ${FLATLINE_PUBLIC_URL}/api/v1/auth/sso/callback
# KORE_ID_REDIRECT_URI=
# Default: ${FLATLINE_PUBLIC_URL}/sign-in
# KORE_ID_POST_LOGOUT_REDIRECT_URI=
# Kore ID decides who may use Flatline (per-user app access, app key `flatline`),
# and everyone it admits gets a full operator account on first sign-in. On a
# fresh install keep this on (the default): the first sign-in provisions the
# first operator.
KORE_ID_AUTO_PROVISION=true
# Optional extra filter (comma separated): when set, only these may get an account.
KORE_ID_ALLOWED_EMAILS=
KORE_ID_ALLOWED_SUBS=
# The app switcher's other Kore apps (app=url, comma separated) and the Kore ID account page.
# KORE_APP_URLS=kore=https://files.example,koremind=https://mind.example,korecalendar=https://cal.example
# KORE_ID_ACCOUNT_URL=
